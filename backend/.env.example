# Server
PORT=8000
LITSERVE_PORT=8001

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Model
HF_TOKEN=
MODEL_CACHE_DIR=.model_cache
# Decision model backend: laya (421M, 512-token states) |
# decider-2b (Qwen3.5-2B System One reproduction, 32k-token states,
# CUDA-bf16 batched scoring). Same typed-question API either way.
DECISION_MODEL=laya

# Logging
LOG_LEVEL=INFO
